{
  "manifest_version": 3,
  "name": "Lexicon",
  "version": "0.1.0",
  "description": "Grammar, spelling, and rewrite suggestions from Lexicon's local engine (desktop app required).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lexicon@lexicon.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_title": "Lexicon",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "commands": {
    "lexicon-proofread": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Proofread the focused text field"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": [
        "vendor/browser-polyfill.min.js",
        "detectEditable.js",
        "squiggle.js",
        "suggestions.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "activeTab", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}

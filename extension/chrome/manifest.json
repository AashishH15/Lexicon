{
  "manifest_version": 3,
  "name": "Lexicon",
  "version": "0.1.0",
  "description": "Grammar, spelling, Tone, and rewrite suggestions from Lexicon's desktop app (local by default; desktop app required).",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Lexicon",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "lexicon-proofread": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Proofread the focused text field"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": [
        "vendor/browser-polyfill.min.js",
        "lexStatus.js",
        "detectEditable.js",
        "squiggle.js",
        "suggestions.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "activeTab", "storage"],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/lex-idle.svg",
        "icons/lex-checking.svg",
        "icons/lex-disabled.svg",
        "icons/lex-no-connection.svg",
        "icons/lex-issues.svg",
        "icons/lex-error.svg",
        "icons/lex-all-clear.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
